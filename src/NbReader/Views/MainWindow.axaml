<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NbReader.ViewModels"
        xmlns:v="using:NbReader.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
        x:Class="NbReader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Reader.ComicName, StringFormat='NbReader - {0}', FallbackValue='NbReader'}"
        MinWidth="640" MinHeight="480">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Padding="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📂 打开文件" Click="OnOpenFileClick" />
                <Button Content="📁 打开文件夹" Click="OnOpenFolderClick" />
                <Button Content="🎨 演示" Command="{Binding LoadDemoCommand}"
                        Background="#FF3A6B35" Foreground="White" />
                <Separator Width="1" Height="20" />
                <TextBlock Text="{Binding Reader.ComicName}"
                           VerticalAlignment="Center"
                           FontWeight="Bold" />
            </StackPanel>
        </Border>

        <!-- 中央阅读区域 — 使用 ViewLocator 自动匹配 ReaderView -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Padding="8,4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding Reader.StatusText}" FontSize="12" />
                <TextBlock FontSize="12" Foreground="Gray">
                    <Run Text="缩放: " /><Run Text="{Binding Reader.ZoomLevel, StringFormat={}{0:P0}}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

</Window>
