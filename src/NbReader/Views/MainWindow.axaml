<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NbReader.ViewModels"
        xmlns:v="using:NbReader.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="720"
        x:Class="NbReader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        DragDrop.AllowDrop="True"
        Title="{Binding WindowTitle}"
        MinWidth="640" MinHeight="480">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ═══ 顶部工具栏 ═══ -->
        <Border Grid.Row="0" Padding="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="📂 打开文件" Click="OnOpenFileClick" />
                <Button Content="📁 打开文件夹" Click="OnOpenFolderClick" />
                <Button x:Name="DemoButton" Content="🎨 演示" Command="{Binding LoadDemoCommand}"
                        Background="#FF3A6B35" Foreground="White" />
                <Separator Width="1" Height="20" />
                <Button Content="{Binding Reader.ReadingDirectionText}"
                        Command="{Binding Reader.CycleReadingDirectionCommand}"
                        ToolTip.Tip="切换阅读方向 (D)"
                        IsVisible="{Binding IsReaderActive}" />
                <Button Content="{Binding Reader.ReadingModeText}"
                        Command="{Binding Reader.CycleReadingModeCommand}"
                        ToolTip.Tip="切换阅读模式 (M)"
                        IsVisible="{Binding IsReaderActive}" />
                <Button Content="{Binding Reader.FitModeText}"
                        Command="{Binding Reader.CycleFitModeCommand}"
                        ToolTip.Tip="切换适应模式 (F)"
                        IsVisible="{Binding IsReaderActive}" />
                <Separator Width="1" Height="20" IsVisible="{Binding IsReaderActive}" />
                <TextBlock Text="{Binding Reader.ComicName}"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           IsVisible="{Binding IsReaderActive}" />
            </StackPanel>
        </Border>

        <!-- ═══ 中央区域：导航栏 + 内容区 ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Padding="4,8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0"
                    MinWidth="120" MaxWidth="200">
                <StackPanel Spacing="4">
                    <TextBlock Text="导航" FontWeight="Bold" FontSize="13"
                               Margin="8,0,0,8" />
                    <Button Content="📚 书架"
                            Command="{Binding NavigateToLibraryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" />
                    <Button Content="🕐 历史"
                            Command="{Binding NavigateToHistoryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" />
                    <Button Content="📖 正在阅读"
                            Command="{Binding NavigateToReaderCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            IsVisible="{Binding IsReaderActive, Converter={x:Static BoolConverters.Not}}" />
                    <Separator Margin="4,8" />
                    <TextBlock Text="快捷键" FontSize="11" Foreground="Gray"
                               Margin="8,0,0,4" />
                    <TextBlock Text="Ctrl+N  书架" FontSize="11" Foreground="Gray"
                               Margin="8,0,0,2" />
                    <TextBlock Text="Ctrl+H  历史" FontSize="11" Foreground="Gray"
                               Margin="8,0,0,2" />
                </StackPanel>
            </Border>

            <!-- 内容区：三个视图常驻，用可见性切换 -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding Reader}"
                                IsVisible="{Binding IsReaderActive}" />
                <ContentControl Content="{Binding Library}"
                                IsVisible="{Binding IsLibraryActive}" />
                <ContentControl Content="{Binding History}"
                                IsVisible="{Binding IsHistoryActive}" />
            </Grid>

            <!-- 加载状态覆盖层 -->
            <Border Grid.Column="1" IsVisible="{Binding Reader.IsLoading}"
                    Background="#88000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="6" />
                    <TextBlock Text="{Binding Reader.StatusText}"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ 底部状态栏 ═══ -->
        <Border Grid.Row="2" Padding="8,4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ProgressBar IsVisible="{Binding Reader.IsLoading}"
                             IsIndeterminate="True"
                             Width="80" Height="10" />
                <TextBlock Text="{Binding Reader.StatusText}" FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding Reader.IsNotScrollMode}" />
                <TextBlock Text="{Binding Reader.ScrollPageText}" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Reader.ReadingModeText}" FontSize="12"
                           Foreground="Gray" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Reader.ReadingDirectionText}" FontSize="12"
                           Foreground="Gray" VerticalAlignment="Center"
                           IsVisible="{Binding Reader.IsNotScrollMode}" />
                <TextBlock Text="{Binding Reader.FitModeText}" FontSize="12"
                           Foreground="Gray" VerticalAlignment="Center" />
                <TextBlock FontSize="12" Foreground="Gray"
                           VerticalAlignment="Center">
                    <Run Text="缩放: " /><Run Text="{Binding Reader.ZoomLevel, StringFormat={}{0:P0}}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>

</Window>
