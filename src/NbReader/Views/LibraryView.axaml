<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbReader.ViewModels"
             xmlns:models="using:NbReader.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NbReader.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="180,*">
        <!-- 搜索工具栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Watermark="🔍 搜索..." Text="{Binding SearchText}" MinWidth="200" />
                <Button Content="🔍" Command="{Binding SearchCommand}" />
                <Button Content="✕" Command="{Binding ClearSearchCommand}" />
                <Separator Width="1" Height="20" />
                <Button Content="{Binding SortByText}" Command="{Binding CycleSortCommand}" />
                <Button Command="{Binding ToggleViewCommand}">
                    <Panel>
                        <TextBlock Text="▦" IsVisible="{Binding IsGridView}" />
                        <TextBlock Text="☰" IsVisible="{Binding !IsGridView}" />
                    </Panel>
                </Button>
                <Separator Width="1" Height="20" />
                <Button Content="📂 扫描目录" Click="OnScanDirectoryClick"
                        IsEnabled="{Binding !IsScanning}" />
                <Button Content="🔄 扫描全部" Command="{Binding ScanAllCommand}"
                        IsEnabled="{Binding !IsScanning}" />
                <TextBlock Text="{Binding ScanStatusText}"
                           FontSize="12" Foreground="Gray"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsScanning}" />
            </StackPanel>
        </Border>

        <!-- 筛选 Chip 栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="6,4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding HasActiveFilters}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="+ 筛选" Command="{Binding ToggleFilterDropdownCommand}"
                        FontSize="12" Padding="6,2" />
                <ItemsControl ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActiveFilter">
                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="10" Padding="6,2" Margin="2,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <Button Content="×" FontSize="10" Padding="2,0"
                                            Background="Transparent"
                                            Click="OnRemoveFilterClick" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 筛选下拉面板 -->
        <Border Grid.Row="1" Grid.Column="1" Padding="8"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="4" Margin="4"
                IsVisible="{Binding IsFilterDropdownOpen}"
                ZIndex="100"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                MinWidth="200" MaxHeight="300">
            <ScrollViewer>
                <StackPanel Spacing="8">
                    <!-- 语言 -->
                    <TextBlock Text="语言" FontWeight="Bold" FontSize="13" />
                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding .}" FontSize="12" Padding="6,2" Margin="2"
                                        Click="OnAddLanguageFilterClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 内容类型 -->
                    <TextBlock Text="类型" FontWeight="Bold" FontSize="13" />
                    <ItemsControl ItemsSource="{Binding AvailableContentTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding .}" FontSize="12" Padding="6,2" Margin="2"
                                        Click="OnAddContentTypeFilterClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="关闭" Command="{Binding ToggleFilterDropdownCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Padding="4,8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Spacing="2">
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Null}">
                            <TextBlock Text="{Binding AllBooksCount, StringFormat='📁 全部 ({0})'}" />
                        </Button>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            DragDrop.AllowDrop="True"
                                            Command="{Binding DataContext.SelectCategoryCommand, ElementName=Root}"
                                            CommandParameter="{Binding .}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="✏️ 重命名" Click="OnRenameCategoryClick" />
                                                <MenuItem Header="🗑 删除"
                                                          Command="{Binding DataContext.DeleteCategoryCommand, ElementName=Root}"
                                                          CommandParameter="{Binding .}" />
                                                <Separator />
                                                <MenuItem Header="⬆ 上移"
                                                          Command="{Binding DataContext.MoveCategoryUpCommand, ElementName=Root}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="⬇ 下移"
                                                          Command="{Binding DataContext.MoveCategoryDownCommand, ElementName=Root}"
                                                          CommandParameter="{Binding .}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📁" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="Gray" Text="{Binding ResourceCount, StringFormat=' ({0})'}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1" Content="➕ 新建分类"
                        Command="{Binding CreateCategoryCommand}"
                        HorizontalAlignment="Stretch" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding EmptyMessage}"
                       FontSize="18" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />

            <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsEmpty}">
                <Grid>
                    <!-- 网格视图 -->
                    <ItemsControl ItemsSource="{Binding Books}" IsVisible="{Binding IsGridView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicResource">
                                <Border Width="160" Height="230" Margin="8"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="6" ClipToBounds="True"
                                        DoubleTapped="OnComicCardDoubleTapped"
                                        PointerPressed="OnComicCardPointerPressed">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="OnComicCardContextMenuOpened">
                                            <MenuItem x:Name="MenuRead" Header="📖 阅读" />
                                            <MenuItem x:Name="MenuRemoveFromCat" Header="📁 从本分类移除" />
                                            <Separator />
                                            <MenuItem x:Name="MoveToCategoryMenu" Header="📁 移至分类 →" />
                                            <Separator />
                                            <MenuItem x:Name="MenuRemove" Header="🗑 从书架移除" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="*,Auto,Auto" Margin="4">
                                        <Border Grid.Row="0" Background="#FF2D2D3F" CornerRadius="4">
                                            <TextBlock Text="📖" FontSize="48"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <ProgressBar Grid.Row="2" Value="{Binding ProgressPercent}" Maximum="100"
                                                     Height="4" Margin="0,4,0,0"
                                                     Foreground="#FF4A90D9" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 列表视图 -->
                    <ItemsControl ItemsSource="{Binding Books}" IsVisible="{Binding !IsGridView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicResource">
                                <Border Height="72" Margin="8,4"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        CornerRadius="6"
                                        DoubleTapped="OnComicCardDoubleTapped"
                                        PointerPressed="OnComicCardPointerPressed">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="OnComicCardContextMenuOpened">
                                            <MenuItem x:Name="MenuRead" Header="📖 阅读" />
                                            <MenuItem x:Name="MenuRemoveFromCat" Header="📁 从本分类移除" />
                                            <Separator />
                                            <MenuItem x:Name="MoveToCategoryMenu" Header="📁 移至分类 →" />
                                            <Separator />
                                            <MenuItem x:Name="MenuRemove" Header="🗑 从书架移除" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                                        <Border Grid.Column="0" Width="48" Height="56"
                                                Background="#FF2D2D3F" CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="📖" FontSize="24"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PageCount, StringFormat='📄 {0} 页'}"
                                                       FontSize="11" Foreground="Gray" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="2" Value="{Binding ProgressPercent}" Maximum="100"
                                                     Width="80" Height="4"
                                                     VerticalAlignment="Center"
                                                     Foreground="#FF4A90D9" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Padding="8,4"
                       Text="{Binding TotalCount, StringFormat='共 {0} 本'}"
                       FontSize="11" Foreground="Gray" />
        </Grid>
    </Grid>

</UserControl>