<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NbReader.ViewModels"
             xmlns:models="using:NbReader.Core.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="NbReader.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="180,*">
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Watermark="🔍 搜索..." Text="{Binding SearchText}" MinWidth="200" />
                <Button Content="🔍" Command="{Binding SearchCommand}" />
                <Button Content="✕" Command="{Binding ClearSearchCommand}" />
                <Separator Width="1" Height="20" />
                <Button Content="{Binding SortByText}" Command="{Binding CycleSortCommand}" />
                <Button Command="{Binding ToggleViewCommand}">
                    <Panel>
                        <TextBlock Text="▦" IsVisible="{Binding IsGridView}" />
                        <TextBlock Text="☰" IsVisible="{Binding !IsGridView}" />
                    </Panel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Padding="4,8"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Spacing="2">
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Null}">
                            <TextBlock Text="{Binding TotalCount, StringFormat='📁 全部 ({0})'}" />
                        </Button>

                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectCategoryCommand, ElementName=Root}"
                                            CommandParameter="{Binding .}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📁" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Foreground="Gray" Text="{Binding ResourceCount, StringFormat=' ({0})'}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1" Content="➕ 新建分类"
                        Command="{Binding CreateCategoryCommand}"
                        HorizontalAlignment="Stretch" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding EmptyMessage}"
                       FontSize="18" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />

            <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Books}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ComicResource">
                            <Border Width="160" Height="230" Margin="8"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="6">
                                <Grid RowDefinitions="*,Auto,Auto" Margin="4">
                                    <Border Grid.Row="0" Background="#FF2D2D3F" CornerRadius="4">
                                        <TextBlock Text="📖" FontSize="48"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Title}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    <ProgressBar Grid.Row="2" Value="0" Height="4" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Padding="8,4"
                       Text="{Binding TotalCount, StringFormat='共 {0} 本'}"
                       FontSize="11" Foreground="Gray" />
        </Grid>
    </Grid>

</UserControl>